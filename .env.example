# AgentDelta environment variables.
# Copy this file to .env and fill in your key:
#   cp .env.example .env
# .env is gitignored; never commit real keys.

# Anthropic API key. Required only for real model runs (run / run-matrix with
# --network enabled). Task authoring and verification (check-task, --dry-run) need
# no key. The loader also tolerates the common ANTHORPIC_API_KEY misspelling.
ANTHROPIC_API_KEY=sk-ant-your-key-here
