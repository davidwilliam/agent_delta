# AgentDelta environment variables.
# Copy this file to .env and fill in your key:
#   cp .env.example .env
# .env is gitignored; never commit real keys.

# Anthropic API key. Required for real Claude Code runs (the default agent). Task
# authoring and verification (check-task, --dry-run) need no key. The loader also
# tolerates the common ANTHORPIC_API_KEY misspelling.
ANTHROPIC_API_KEY=sk-ant-your-key-here

# OpenAI API key. Required only for Codex CLI runs (--agent codex_cli).
OPENAI_API_KEY=sk-your-openai-key-here

# Google Gemini API key. Required only for Gemini CLI runs (--agent gemini_cli).
GEMINI_API_KEY=your-gemini-key-here
